    },
    {
      "speaker": "agent",
      "text": "Great! Your appointment with Dr. Rohan Kapoor is booked for Thursday 15 Oct at 2:30 pm. Is there anything else I can help you with?"
    },
    {
      "speaker": "patient",
      "text": "No, that's all. Thank you!"
    },
